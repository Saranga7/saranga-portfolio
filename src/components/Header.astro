---
import StaticLogo from "./StaticLogo.astro";
---

<header class="site-header">
  <a class="brand" href="/" aria-label="Saranga Mahanta, home">
    <StaticLogo />
    <span>Saranga <i>Mahanta</i></span>
  </a>
  <nav aria-label="Main navigation">
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-menu">
      <span></span><span></span><span></span><b class="sr-only">Open menu</b>
    </button>
    <div class="nav-links" id="main-menu">
      <a href="/#publications">Publications</a>
      <a href="/#experience">Experience</a>
      <a href="/#education">Education</a>
      <a href="/#misc">Misc</a>
      <a href="/#contact">Contact</a>
    </div>
  </nav>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const menu = document.querySelector<HTMLElement>(".nav-links");
  button?.addEventListener("click", () => {
    const open = button.getAttribute("aria-expanded") === "true";
    button.setAttribute("aria-expanded", String(!open));
    menu?.classList.toggle("open", !open);
  });
  menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => {
    button?.setAttribute("aria-expanded", "false");
    menu.classList.remove("open");
  }));
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 40; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; width: min(100% - 2rem, 78rem); margin-inline: auto; padding: .8rem 0; background: color-mix(in srgb, var(--bg) 86%, transparent); backdrop-filter: blur(14px); border-bottom: 1px solid color-mix(in srgb, var(--border) 70%, transparent); }
  .brand { display: inline-flex; align-items: center; gap: .6rem; width: max-content; color: var(--text); text-decoration: none; font: 600 .84rem/1 var(--font-sans); letter-spacing: .02em; }
  .brand :global(svg) { width: 2.2rem; height: 2.2rem; color: var(--accent); }
  .brand i { font-family: var(--font-serif); font-size: 1.05rem; font-weight: 500; }
  .nav-links { display: flex; align-items: center; gap: 1.7rem; }
  .nav-links a { position: relative; color: var(--muted); font-size: .78rem; font-weight: 600; text-decoration: none; }
  .nav-links a::after { position: absolute; right: 0; bottom: -.4rem; left: 0; height: 1px; background: var(--accent); content: ""; transform: scaleX(0); transition: transform .2s; }
  .nav-links a:hover { color: var(--text); }
  .nav-links a:hover::after { transform: scaleX(1); }
  .menu-toggle { display: none; }
  @media (max-width: 980px) {
    .site-header { grid-template-columns: 1fr auto auto; gap: .7rem; }
    nav { order: 2; }
    .menu-toggle { display: grid; gap: 4px; width: 2.5rem; height: 2.5rem; padding: .65rem; place-content: center; border: 1px solid var(--border); border-radius: 999px; background: var(--surface); }
    .menu-toggle span { display: block; width: 1rem; height: 1px; background: var(--text); }
    .nav-links { position: fixed; top: 4.6rem; right: 1rem; left: 1rem; display: grid; gap: 0; padding: .6rem; border: 1px solid var(--border); border-radius: 1rem; background: var(--surface); box-shadow: var(--shadow); opacity: 0; visibility: hidden; transform: translateY(-.5rem); transition: .2s; }
    .nav-links.open { opacity: 1; visibility: visible; transform: none; }
    .nav-links a { padding: .8rem 1rem; }
    .brand span { display: none; }
  }
</style>
