---
interface Props {
  name: "github" | "linkedin" | "scholar" | "instagram" | "blog";
  class?: string;
}
const { name, class: className = "" } = Astro.props;
---

<svg class:list={["social-icon", className]} viewBox="0 0 24 24" aria-hidden="true">
  {name === "github" && <path d="M12 2.5a9.5 9.5 0 0 0-3 18.5c.5.1.65-.22.65-.47v-1.84c-2.66.58-3.22-1.13-3.22-1.13-.43-1.1-1.06-1.4-1.06-1.4-.87-.6.07-.58.07-.58.96.07 1.47.99 1.47.99.85 1.47 2.24 1.04 2.79.8.08-.62.33-1.04.61-1.28-2.13-.24-4.36-1.06-4.36-4.7 0-1.04.37-1.89.98-2.56-.1-.24-.43-1.21.09-2.52 0 0 .8-.26 2.61.98A9 9 0 0 1 12 6.96a9 9 0 0 1 2.38.32c1.81-1.24 2.61-.98 2.61-.98.52 1.31.19 2.28.09 2.52.61.67.98 1.52.98 2.56 0 3.65-2.24 4.46-4.37 4.7.34.3.65.88.65 1.78v2.67c0 .26.17.57.66.47A9.5 9.5 0 0 0 12 2.5Z" />}
  {name === "linkedin" && <><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M7.5 10v7M7.5 7.2v.1M11 17v-7M11 13c.6-1.8 5.5-2.3 5.5 1.3V17"/></>}
  {name === "scholar" && <><path d="m2.5 9 9.5-5 9.5 5-9.5 5-9.5-5Z"/><path d="M6 11.2v5.1c3.8 2.2 8.2 2.2 12 0v-5.1M21.5 9v6"/></>}
  {name === "instagram" && <><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle class="solid" cx="17.5" cy="6.5" r="1"/></>}
  {name === "blog" && <><path d="M20.5 3.5c-5.8-.3-10.8 2.2-13.7 7.2-1.5 2.6-1.8 5.1-1.7 7.2 2.1.1 4.7-.2 7.2-1.7 5-2.9 7.5-7.9 7.2-13.7Z"/><path d="M4 20c3.7-4.4 7.7-8.4 12.3-11.8M7.2 16.7l-.4-4.6M11.1 12.8l4.7.3"/></>}
</svg>

<style>
  .social-icon { width: 1.1rem; height: 1.1rem; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .social-icon .solid { fill: currentColor; stroke: none; }
  .social-icon path:only-child { fill: currentColor; stroke: none; }
</style>
