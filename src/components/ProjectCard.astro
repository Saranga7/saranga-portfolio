---
import type { CollectionEntry } from "astro:content";
import ProjectArt from "./ProjectArt.astro";

interface Props { project: CollectionEntry<"projects">; index: number; }
const { project, index } = Astro.props;
---

<article class:list={["project-card", `project-${index + 1}`]}>
  <a class="art-link" href={`/projects/${project.data.slug}/`} aria-label={`Read about ${project.data.title}`}>
    <ProjectArt variant={project.data.coverVariant} />
  </a>
  <div class="project-copy">
    <span class="eyebrow">{String(index + 1).padStart(2, "0")} · {project.data.domain}</span>
    <h3><a href={`/projects/${project.data.slug}/`}>{project.data.title}</a></h3>
    <p>{project.data.summary}</p>
    <ul aria-label="Technologies">
      {project.data.technologies.slice(0, 4).map((item) => <li>{item}</li>)}
    </ul>
    <a class="text-link" href={`/projects/${project.data.slug}/`}>View the work <span aria-hidden="true">↗</span></a>
  </div>
</article>

<style>
  .project-card { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(18rem, .85fr); min-height: 30rem; overflow: hidden; border: 1px solid var(--border); border-radius: 1.5rem; background: var(--surface); box-shadow: var(--shadow-soft); }
  .project-card:nth-child(even) { grid-template-columns: minmax(18rem, .85fr) minmax(0, 1.15fr); }
  .project-card:nth-child(even) .art-link { order: 2; }
  .art-link { position: relative; display: block; height: 100%; min-height: 30rem; overflow: hidden; }
  .art-link :global(.project-art) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .project-copy { display: flex; flex-direction: column; align-items: flex-start; justify-content: center; padding: clamp(2rem, 5vw, 4.5rem); }
  h3 { margin: .65rem 0 1rem; font: 500 clamp(2.2rem, 5vw, 4.25rem)/.92 var(--font-serif); letter-spacing: -.04em; }
  h3 a { color: var(--text); text-decoration: none; }
  p { max-width: 34rem; margin: 0; color: var(--muted); }
  ul { display: flex; flex-wrap: wrap; gap: .4rem; margin: 1.5rem 0; padding: 0; list-style: none; }
  li { padding: .36rem .58rem; border: 1px solid var(--border); border-radius: 999px; color: var(--muted); font: 500 .65rem/1 var(--font-mono); }
  @media (max-width: 760px) {
    .project-card, .project-card:nth-child(even) { grid-template-columns: 1fr; }
    .project-card:nth-child(even) .art-link { order: initial; }
    .art-link { height: auto; min-height: 18rem; }
    .project-copy { padding: 1.6rem; }
  }
</style>
