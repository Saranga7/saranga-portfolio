---
import type { CollectionEntry } from "astro:content";
import { blogDate, categoryLabel } from "../data/blog";

interface Props {
  post: CollectionEntry<"blog">;
  index: number;
  featured?: boolean;
  minimal?: boolean;
}
const { post, index, featured = false, minimal = false } = Astro.props;
---

<article class:list={["blog-card", { featured, minimal, "has-cover": Boolean(post.data.coverImage) && !minimal }]}>
  <a href={`/blog/${post.data.slug}`}>
    {post.data.coverImage && !minimal && (
      <div class="cover"><img src={post.data.coverImage} alt="" loading="lazy" /></div>
    )}
    <div class="card-copy">
      <div class="meta">
        <span>{String(index + 1).padStart(2, "0")}</span>
        <span>{categoryLabel(post.data.category)}</span>
        <time datetime={post.data.date.toISOString()}>{blogDate(post.data.date)}</time>
      </div>
      <h2>{post.data.title}</h2>
      {!minimal && <p>{post.data.excerpt}</p>}
      <span class="read">Read <i aria-hidden="true">↗</i></span>
    </div>
  </a>
</article>

<style>
  .blog-card { border-bottom: 1px solid var(--border); }
  .blog-card > a { display: block; padding: clamp(2rem, 4vw, 3.5rem) 0; color: inherit; text-decoration: none; }
  .card-copy { display: grid; grid-template-columns: minmax(13rem, .9fr) minmax(16rem, 1.1fr) auto; gap: clamp(1.5rem, 5vw, 5rem); align-items: start; }
  .meta { display: flex; flex-wrap: wrap; gap: .5rem 1rem; color: var(--muted); font: 600 .58rem var(--font-mono); letter-spacing: .07em; text-transform: uppercase; }
  .meta span:first-child { color: var(--accent); }
  h2 { margin: -.15rem 0 0; font: 500 clamp(1.8rem, 3.5vw, 3.25rem)/1 var(--font-serif); letter-spacing: -.035em; transition: color .2s; }
  p { max-width: 30rem; margin: 0; color: var(--muted); font-size: .82rem; }
  .read { align-self: end; color: var(--text); font: 700 .65rem var(--font-sans); }
  .read i { color: var(--accent); font-style: normal; }
  .blog-card a:hover h2 { color: var(--accent); }
  .cover { overflow: hidden; height: clamp(18rem, 42vw, 34rem); margin-bottom: 2rem; border-radius: 1.25rem; background: var(--surface-2); }
  .cover img { width: 100%; height: 100%; object-fit: cover; filter: saturate(.82); transition: transform .5s, filter .3s; }
  .has-cover a:hover img { filter: saturate(1); transform: scale(1.015); }
  .featured .card-copy { grid-template-columns: .55fr 1.1fr .9fr; }
  .featured h2 { font-size: clamp(2.6rem, 5.6vw, 5.3rem); }
  .minimal .card-copy { grid-template-columns: minmax(12rem, .7fr) minmax(16rem, 1.3fr) auto; align-items: center; }
  .minimal h2 { font-size: clamp(1.8rem, 3.5vw, 3rem); }
  @media (max-width: 760px) {
    .card-copy, .featured .card-copy { grid-template-columns: 1fr auto; gap: 1rem; }
    .meta { grid-column: 1 / -1; }
    .card-copy > p { grid-column: 1; }
    .read { grid-row: 2 / span 2; grid-column: 2; }
  }
</style>
