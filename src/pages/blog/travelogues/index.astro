---
import { getCollection } from "astro:content";
import BlogCard from "../../../components/BlogCard.astro";
import BlogLayout from "../../../layouts/BlogLayout.astro";

const posts = (await getCollection("blog", ({ data }) =>
  !data.draft && data.category === "travelogues"
)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BlogLayout
  title="Travelogues · Seventh Insight"
  description="Journeys and travel writing from Seventh Insight."
  active="write-ups"
>
  <header class="travel-hero container">
    <a href="/blog/category/write-ups">← Write-ups</a>
    <p class="eyebrow">Seventh Insight · Journeys</p>
    <h1>Travelogues<span>.</span></h1>
  </header>

  <section class="travel-list container" aria-label="Travelogues">
    <div class="count">
      <span>{String(posts.length).padStart(2, "0")}</span>
      <p>{posts.length === 1 ? "journey" : "journeys"}</p>
    </div>
    <div>
      {posts.map((post, index) => <BlogCard post={post} index={index} featured={index === 0} />)}
    </div>
  </section>
</BlogLayout>

<style>
  .travel-hero { padding: clamp(4rem, 9vw, 8rem) 0 clamp(4rem, 8vw, 7rem); }
  .travel-hero > a { display: inline-block; margin-bottom: clamp(4rem, 8vw, 7rem); color: var(--muted); font: 600 .62rem var(--font-mono); text-decoration: none; }
  h1 { margin: .8rem 0 0; font: 500 clamp(4.5rem, 11vw, 10rem)/.8 var(--font-serif); letter-spacing: -.07em; }
  h1 span { color: var(--accent); }
  .travel-list { display: grid; grid-template-columns: .28fr 1fr; gap: clamp(2rem, 7vw, 7rem); padding-bottom: clamp(7rem, 13vw, 12rem); }
  .count { padding-top: 2rem; border-top: 1px solid var(--border); }
  .count span { color: var(--accent); font: 500 clamp(2.5rem, 5vw, 4.5rem) var(--font-serif); }
  .count p { margin: .2rem 0 0; color: var(--muted); font: 600 .58rem var(--font-mono); text-transform: uppercase; }
  @media (max-width: 720px) {
    .travel-list { grid-template-columns: 1fr; }
    .count { display: flex; gap: 1rem; align-items: baseline; }
  }
</style>
