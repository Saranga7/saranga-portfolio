---
import { getCollection, type CollectionEntry } from "astro:content";
import BlogCard from "../../../components/BlogCard.astro";
import BlogLayout from "../../../layouts/BlogLayout.astro";
import { blogCategories, type BlogCategory } from "../../../data/blog";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return blogCategories
    .filter((category) => !["haiku", "random-bs"].includes(category.slug))
    .map((category) => ({
    params: { category: category.slug },
    props: {
      category,
      posts: posts
        .filter((post) =>
          post.data.category === category.slug
            && post.data.slug !== "thoughts"
        )
        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
    },
  }));
}

interface Props {
  category: typeof blogCategories[number];
  posts: CollectionEntry<"blog">[];
}
const { category, posts } = Astro.props;
---

<BlogLayout
  title={`${category.fullLabel} · Seventh Insight`}
  description={category.description}
  active={category.slug satisfies BlogCategory}
>
  <header class="category-hero container">
    <p class="eyebrow">Seventh Insight · Collection</p>
    <h1>{category.fullLabel}<span>.</span></h1>
    <p>{category.description}</p>
  </header>

  <section class="category-list container" aria-label={`${category.label} archive`}>
    <div class="count">
      <span>{String(posts.length).padStart(2, "0")}</span>
      <p>{posts.length === 1 ? "piece" : "pieces"} in this room</p>
    </div>
    <div>
      {category.slug === "write-ups" && (
        <div class="side-collections">
          <a class="notes-link" href="/blog/thoughts">
            <span class="eyebrow">Smaller notes</span>
            <strong>Thoughts</strong>
            <i aria-hidden="true">→</i>
          </a>
          <a class="notes-link" href="/blog/travelogues">
            <span class="eyebrow">Journeys</span>
            <strong>Travelogues</strong>
            <i aria-hidden="true">→</i>
          </a>
        </div>
      )}
      {posts.map((post, index) => (
        <BlogCard
          post={post}
          index={index}
          featured={category.slug !== "poems" && index === 0}
          minimal={category.slug === "poems"}
          showReadingTime={category.slug === "write-ups"}
        />
      ))}
    </div>
  </section>
</BlogLayout>

<style>
  .category-hero { padding: clamp(5rem, 11vw, 10rem) 0 clamp(4rem, 8vw, 7rem); }
  h1 { max-width: 12ch; margin: .8rem 0 1.2rem; font: 500 clamp(4.5rem, 11vw, 10rem)/.8 var(--font-serif); letter-spacing: -.07em; }
  h1 span { color: var(--accent); }
  .category-hero > p:last-child { max-width: 34rem; margin: 0; color: var(--muted); font-size: 1.05rem; }
  .category-list { display: grid; grid-template-columns: .28fr 1fr; gap: clamp(2rem, 7vw, 7rem); padding-bottom: clamp(7rem, 13vw, 12rem); }
  .count { padding-top: 2rem; border-top: 1px solid var(--border); }
  .count span { color: var(--accent); font: 500 clamp(2.5rem, 5vw, 4.5rem) var(--font-serif); }
  .count p { margin: .2rem 0 0; color: var(--muted); font: 600 .58rem var(--font-mono); text-transform: uppercase; }
  .side-collections { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin-bottom: 2rem; }
  .notes-link { position: relative; display: block; min-height: 12rem; padding: 1.5rem; border: 1px solid var(--border); border-radius: 1rem; color: inherit; background: var(--surface); text-decoration: none; }
  .notes-link strong { display: block; margin: 2rem 0 .45rem; font: 500 clamp(2rem, 4vw, 3.5rem)/1 var(--font-serif); }
  .notes-link i { position: absolute; right: 1.5rem; bottom: 1.5rem; color: var(--accent); font-size: 1.4rem; font-style: normal; }
  .notes-link:hover strong { color: var(--accent); }
  @media (max-width: 720px) {
    .category-list { grid-template-columns: 1fr; }
    .count { display: flex; gap: 1rem; align-items: baseline; }
    .side-collections { grid-template-columns: 1fr; }
  }
</style>
