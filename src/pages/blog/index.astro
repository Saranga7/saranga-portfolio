---
import { getCollection } from "astro:content";
import BlogLayout from "../../layouts/BlogLayout.astro";
import { blogCategories } from "../../data/blog";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const collectionCounts: Record<string, number> = {
  haiku: 35,
  "random-bs": 25,
};
---

<BlogLayout
  title="Seventh Insight · Saranga Kingkor Mahanta"
  description="Poems, haiku, essays, travel notes, and assorted reflections by Saranga Kingkor Mahanta."
>
  <section class="blog-hero container" aria-labelledby="blog-title">
    <div>
      <p class="eyebrow">A personal archive · 2020—Now</p>
      <h1 id="blog-title">My<br /><em>anthology.</em></h1>
    </div>
    <p>
      Poems, haiku, essays, journeys, and thoughts—collected in their own corners
      below.
    </p>
  </section>

  <section class="categories container" aria-labelledby="rooms-title">
    <div class="category-heading">
      <p class="eyebrow" id="rooms-title">Choose a section</p>
    </div>
    <div class="category-grid">
      {blogCategories.map((category, index) => (
        <a href={
          category.slug === "haiku"
            ? "/blog/haiku"
            : category.slug === "random-bs"
              ? "/blog/random-bullshit"
              : `/blog/category/${category.slug}`
        }>
          <div>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <span>{String(collectionCounts[category.slug] ?? posts.filter((post) =>
              post.data.category === category.slug
                && post.data.slug !== "thoughts"
            ).length).padStart(2, "0")} pieces</span>
          </div>
          <h3>{category.fullLabel}</h3>
          <p>{category.description}</p>
          <i aria-hidden="true">→</i>
        </a>
      ))}
    </div>
  </section>

  <section class="source-note container">
    <p>
      Original <a href="https://seventhinsight.wordpress.com">WordPress archive ↗</a>.
    </p>
  </section>
</BlogLayout>

<style>
  .blog-hero { display: grid; grid-template-columns: 1.25fr .75fr; gap: clamp(3rem, 8vw, 8rem); align-items: end; padding: clamp(5rem, 11vw, 10rem) 0; }
  h1 { margin: .8rem 0 0; font: 500 clamp(4rem, 9vw, 8.4rem)/.83 var(--font-serif); letter-spacing: -.065em; }
  em { color: var(--accent); font-weight: inherit; }
  .blog-hero > p { max-width: 31rem; margin: 0 0 .5rem; color: var(--muted); font-size: clamp(1rem, 1.5vw, 1.2rem); }
  .categories { padding: 0 0 clamp(6rem, 12vw, 11rem); }
  .category-heading { margin-bottom: 2rem; }
  .category-grid { display: grid; grid-template-columns: repeat(2, 1fr); border-top: 1px solid var(--border); border-left: 1px solid var(--border); }
  .category-grid a { position: relative; min-height: 19rem; padding: 1.7rem; border-right: 1px solid var(--border); border-bottom: 1px solid var(--border); color: inherit; text-decoration: none; transition: background .2s; }
  .category-grid a > div { display: flex; justify-content: space-between; gap: 1rem; }
  .category-grid span { color: var(--accent); font: 600 .6rem var(--font-mono); text-transform: uppercase; }
  .category-grid span:last-child { color: var(--muted); }
  .category-grid h3 { margin: 3.8rem 0 .8rem; font: 500 clamp(2rem, 4vw, 3.8rem)/1 var(--font-serif); letter-spacing: -.04em; }
  .category-grid p { max-width: 25rem; margin: 0; color: var(--muted); font-size: .78rem; }
  .category-grid i { position: absolute; right: 1.7rem; bottom: 1.7rem; color: var(--accent); font-size: 1.4rem; font-style: normal; }
  .category-grid a:hover { background: var(--surface); }
  .source-note { padding-bottom: 4rem; color: var(--muted); font-size: .68rem; text-align: right; }
  .source-note a { color: var(--text); }
  @media (max-width: 760px) {
    .blog-hero { grid-template-columns: 1fr; }
    .category-grid { grid-template-columns: 1fr; }
  }
</style>
