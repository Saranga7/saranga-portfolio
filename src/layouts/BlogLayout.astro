---
import BaseLayout from "./BaseLayout.astro";
import BlogNav from "../components/BlogNav.astro";

interface Props {
  title: string;
  description: string;
  active?: string;
}
const { title, description, active = "home" } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="blog-masthead container">
    <a class="portfolio-link" href="/">← Research portfolio</a>
    <a class="blog-brand" href="/blog" aria-label="Seventh Insight, blog home">
      <strong>Seventh <em>Insight</em></strong>
      <span>For I shall perish, not my words.</span>
    </a>
    <BlogNav active={active} />
  </div>
  <slot />
</BaseLayout>

<style>
  .blog-masthead { display: grid; grid-template-columns: 1fr auto; gap: 1.5rem 3rem; align-items: end; padding: 2.2rem 0 1.5rem; border-bottom: 1px solid var(--border); }
  .portfolio-link { align-self: start; color: var(--muted); font: 600 .6rem var(--font-mono); text-decoration: none; }
  .blog-brand { grid-row: 2; color: var(--text); text-decoration: none; }
  .blog-brand strong { display: block; font: 500 clamp(2rem, 4vw, 3.5rem)/1 var(--font-serif); letter-spacing: -.035em; }
  .blog-brand strong em { color: var(--accent); font-style: normal; }
  .blog-brand span { display: block; margin-top: .45rem; color: var(--muted); font: italic .83rem var(--font-serif); }
  :global(.blog-nav) { grid-row: 2; }
  @media (max-width: 800px) {
    .blog-masthead { grid-template-columns: 1fr; align-items: start; }
    .blog-brand, :global(.blog-nav) { grid-row: auto; }
    :global(.blog-nav) { width: 100%; }
  }
</style>
